{
  "name": "@achromat-ai/mcp-server",
  "version": "0.1.0",
  "description": "MCP server that lets an agent recall and calibrate tool calls against Achromat MOM (mom.achromat.ai), from any MCP host.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achromat-ai/achromat-mcp-server.git"
  },
  "homepage": "https://github.com/achromat-ai/achromat-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/achromat-ai/achromat-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "achromat",
    "policy",
    "compliance"
  ],
  "bin": {
    "achromat-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
